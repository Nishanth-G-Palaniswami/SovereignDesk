# SovereignDesk, local only. Copy to .env and fill in on the box.
# Never commit .env. Never paste a real token into a command or a chat message.

# ---- inference (lane 1) ----
# NemoClaw picks the provider. ollama is the offline path, no container pull.
NEMOCLAW_PROVIDER=ollama
NEMOCLAW_MODEL=qwen3.6:35b
NEMOCLAW_SANDBOX=customs-desk

# ---- channel: Matrix, primary (lane 6) ----
# Homeserver runs ON the box. This address is local, so nothing leaves.
MATRIX_HOMESERVER=http://127.0.0.1:6167
MATRIX_USER=@customsdesk:sovereigndesk.local
MATRIX_ACCESS_TOKEN=replace_me
MATRIX_ROOM_ID=!replace_me:sovereigndesk.local

# ---- channel: Telegram, documented fallback only (lane 6) ----
# Only used if the Matrix homeserver will not come up. Requires real egress.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_CHAT_ID=replace_me

# ---- engine (lane 3) ----
WORKSPACE_ROOT=/workspace/sovereigndesk/workspace
