# SovereignDesk, local only. Copy to .env and fill in on the box.
# Never commit .env. Never paste a real token into a command or a chat message:
# transcripts persist to disk, so a token in a command is a token on disk.

# ---- inference, lane 1 ----
# NemoClaw is the connection and inference layer. It provisions the OpenShell sandbox and
# serves the model. It is NOT the memory layer.
# ollama is the offline path: no container image pull, which matters on venue wifi.
NEMOCLAW_PROVIDER=ollama
# Team decision 2026-08-22: Llama 70B. NOTE the exact tag: "Llama 3.2 70B" does not exist
# (3.2 is 1B/3B text and 11B/90B vision). The 70B models are llama3.1:70b and llama3.3:70b;
# this assumes 3.3, the newest. Q4 is ~43 GB, fits the 128 GB box. Dense 70B writes memos
# slower than the 35B-A3B MoE the bible picked; if the cron tick backs up, qwen3.6:35b is
# the staged fallback and a one-line swap.
NEMOCLAW_MODEL=llama3.3:70b
NEMOCLAW_SANDBOX=customs-desk

# ---- review console, lane 6 ----
# The entire human-in-the-loop surface. Bound to loopback, because loopback is the one
# thing the drop policy does not drop. There is no allowlist and no relay.
# CONSOLE_HOST is documentation only: server.mjs hardcodes 127.0.0.1 (server.mjs:48) and
# reads CONSOLE_PORT only. Changing this value does nothing, which is deliberate.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=7777

# ---- MongoDB retrieval index, lane 4 ----
# OPTIONAL and default-off: these ship commented out because an active MONGO_URI in a
# copied .env silently flips the engine into Mongo mode. precedents.jsonl stays the
# append-only source of truth; the index is derived and rebuilt with scripts/mongo_sync.mjs
# (+ scripts/mongo_load_tariff.mjs for the full-schedule collection). With MONGO_URI set,
# a dead mongod or a stale index is a LOUD engine error, never a silent fallback. mongod
# binds loopback only. MONGOSH_BIN: real executable, C:/-style path on Windows, no .cmd shim.
# MONGO_URI=mongodb://127.0.0.1:27017/?serverSelectionTimeoutMS=2000
# MONGO_DB=sovereigndesk
# MONGOSH_BIN=replace_me

# ---- workspace ----
# Must be the HOST-side path that is share-mounted into the sandbox. precedents.jsonl lives
# at its root and must stay outside the sandbox, or the teardown demo breaks.
WORKSPACE_ROOT=/workspace/sovereigndesk/workspace

# ---- later, not part of this build ----
# Remote approval over a self-hosted mesh (Matrix homeserver on the box, or a Bluetooth LE
# mesh such as Bitchat) so a broker could approve from a phone without the public internet.
# A zero-dependency Client-Server API spike sits at lanes/6-channel-ui/matrix_bridge.mjs.
# Not built, not demoed, not on the critical path. Uncomment only if that work starts.
# MATRIX_HOMESERVER=http://127.0.0.1:6167
# MATRIX_USER=@customsdesk:sovereigndesk.local
# MATRIX_ACCESS_TOKEN=replace_me
# MATRIX_ROOM_ID=!replace_me:sovereigndesk.local
